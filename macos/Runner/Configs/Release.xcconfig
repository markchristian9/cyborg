#include "../../Flutter/Flutter-Release.xcconfig"
#include "Warnings.xcconfig"

// ── 서명 ────────────────────────────────────────────────────────────────
// 기본은 ad-hoc("-") 서명이다. 인증서가 없는 기계에서도 Release 로 빌드해서
// 그 자리에서 실행할 수 있어야 하기 때문이다. 여러 클라이언트를 한꺼번에 띄우는
// scripts/run.sh 가 쓰는 것이 바로 이 Release 빌드다.
//
// 예전에는 여기서 곧장 Developer ID 로 서명했다. 그러면 인증서가 없는 기계는
// 빌드조차 못 하고 이렇게 멈춘다.
//
//   error: No signing certificate "Developer ID Application" found
//
// Developer ID 는 앱을 남에게 건네줄 때만 필요하다. 그래서 배포용 서명 설정은
// scripts/release-macos.sh 가 빌드 직전에 Signing.xcconfig 로 만들어 끼워 넣고,
// 끝나면 지운다. 그 파일이 없으면 아래 include 는 조용히 넘어가고 서명은 ad-hoc
// 으로 남는다(#include? 는 파일이 없어도 오류가 아니다).
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

#include? "Signing.xcconfig"
